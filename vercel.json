{
  "version": 2,
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.py"
    }
  ],
  "includeFiles": [
    "Database/**",
    "Helper/**",
    "Middleware/**",
    "PydanticModels/**",
    "routes/**",
    "SqlModels/**",
    "index.py",
    "requirements.txt",
    "pyproject.toml",
    ".env"
  ],
  "maxDuration": 60
}
